# ══════════════════════════════════════════════════════════
# Universal Stations — En-têtes de sécurité HTTP (Netlify)
# ══════════════════════════════════════════════════════════

/*
  # Interdit d'afficher le site dans une iframe (anti-clickjacking)
  X-Frame-Options: SAMEORIGIN
  # Empêche le navigateur de deviner les types de fichiers (anti-sniffing)
  X-Content-Type-Options: nosniff
  # Limite les infos envoyées aux sites externes lors des clics sortants
  Referrer-Policy: strict-origin-when-cross-origin
  # Coupe l'accès aux capteurs inutiles (caméra, micro, géolocalisation)
  Permissions-Policy: camera=(), microphone=(), geolocation=()
